rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Regla principal: cada usuario solo puede acceder a sus propios datos ──
    match /usuarios/{userId} {
      // Campos que SOLO puede escribir el servidor (Admin SDK, que ignora estas
      // reglas): el nivel de donante y los contadores de uso. Si el cliente
      // pudiera escribirlos, cualquiera se marcaría como donante desde la consola
      // del navegador o se reiniciaría el contador del límite mensual.
      function camposDeServidor() {
        return ['suscripcion', 'uso', 'credenciales_externas'];
      }

      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(camposDeServidor());

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDeServidor());

      allow delete: if request.auth != null && request.auth.uid == userId;

      // Subcolección de carreras
      match /carreras/{carreraId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección de materias
      match /materias/{materiaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Ninguna otra colección es accesible ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
