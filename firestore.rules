rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de validación ──────────────────────────────────────────
    // Acotan lo que se puede guardar para que la base no se pueda usar como
    // almacenamiento gratuito (un documento de Firestore admite hasta 1 MB:
    // sin topes, alguien podría meter blobs en cualquier campo de texto).

    function esDueño(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Texto opcional: si el campo viene, tiene que ser string y no exceder el largo.
    function textoOpcionalOk(datos, campo, maxLargo) {
      return !(campo in datos)
        || (datos[campo] is string && datos[campo].size() <= maxLargo);
    }

    // Lista opcional: si el campo viene, tiene que ser lista y no exceder el tamaño.
    function listaOpcionalOk(datos, campo, maxItems) {
      return !(campo in datos)
        || (datos[campo] is list && datos[campo].size() <= maxItems);
    }

    function materiaValida() {
      let d = request.resource.data;
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 200
        && textoOpcionalOk(d, 'codigo_interno', 50)
        && textoOpcionalOk(d, 'periodo_cursado', 50)
        && textoOpcionalOk(d, 'estado', 20)
        && listaOpcionalOk(d, 'evaluaciones', 200)
        && listaOpcionalOk(d, 'fechas_importantes', 200)
        && listaOpcionalOk(d, 'correlativas_requisito', 100)
        && listaOpcionalOk(d, 'carreras_vinculadas', 20);
    }

    function carreraValida() {
      let d = request.resource.data;
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 200
        && textoOpcionalOk(d, 'institucion', 200)
        && textoOpcionalOk(d, 'color', 30);
    }

    function perfilValido() {
      let d = request.resource.data;
      return !('perfil' in d) || (
        textoOpcionalOk(d.perfil, 'nombre', 200)
        && textoOpcionalOk(d.perfil, 'email', 320)
        && textoOpcionalOk(d.perfil, 'bio', 500)
        && textoOpcionalOk(d.perfil, 'universidad', 200)
        && textoOpcionalOk(d.perfil, 'alias', 40)
        && textoOpcionalOk(d.perfil, 'avatar_url', 2000)
      );
    }

    // ── Regla principal: cada usuario solo puede acceder a sus propios datos ──
    match /usuarios/{userId} {
      // Campos que SOLO puede escribir el servidor (Admin SDK, que ignora estas
      // reglas): el nivel de donante y los contadores de uso. Si el cliente
      // pudiera escribirlos, cualquiera se marcaría como donante desde la consola
      // del navegador o se reiniciaría el contador del límite mensual.
      function camposDeServidor() {
        return ['suscripcion', 'uso', 'credenciales_externas'];
      }

      allow read: if esDueño(userId);

      allow create: if esDueño(userId)
        && !request.resource.data.keys().hasAny(camposDeServidor())
        && perfilValido();

      allow update: if esDueño(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDeServidor())
        && perfilValido();

      allow delete: if esDueño(userId);

      // Subcolección de carreras
      match /carreras/{carreraId} {
        allow read, delete: if esDueño(userId);
        allow create, update: if esDueño(userId) && carreraValida();
      }

      // Subcolección de materias
      match /materias/{materiaId} {
        allow read, delete: if esDueño(userId);
        allow create, update: if esDueño(userId) && materiaValida();
      }
    }

    // ── Catálogo compartido de materias y comentarios ──
    //
    // Lectura: cualquier usuario autenticado (es contenido comunitario).
    // Escritura: NADIE desde el cliente. Todo pasa por las rutas de API con el
    // Admin SDK, que es lo único que permite validar de verdad — largo del
    // texto, dominios de los links, cooldown entre comentarios, contadores de
    // votos consistentes. Si el cliente pudiera escribir, podría inventar
    // votos, falsear el alias de otro o llenar el catálogo de basura.
    match /catalogo_materias/{materiaId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /{documentoAnidado=**} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ── Ninguna otra colección es accesible ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
