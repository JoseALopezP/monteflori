# Copiá este archivo a .env.local y completá los valores.
# Ver README.md para el detalle de cada variable.

# Firebase (config del SDK cliente, ver Firebase Console → Configuración del proyecto)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-side, API routes) — JSON completo del service account en una sola línea
FIREBASE_SERVICE_ACCOUNT_KEY=

# URL pública de la app (para redirects de OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar OAuth (ambas server-side: la URL de autorización se arma en el servidor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secreto para firmar el parámetro `state` del OAuth de Google (anti-CSRF).
# Generá uno con: openssl rand -base64 32
OAUTH_STATE_SECRET=

# ID de la extensión de Chrome (ya está fijo en extension/manifest.json)
NEXT_PUBLIC_EXTENSION_ID=hlncdppelkcpkgadmeanalfeoobajeac

# Cron de recordatorios (Vercel Cron llama a /api/cron/send-reminders con este secret)
CRON_SECRET=

# WhatsApp Cloud API — en pausa, ver README
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v19.0

# Mercado Pago — donaciones recurrentes (nivel donante).
# Sacalos de https://www.mercadopago.com.ar/developers → tu aplicación.
# Sin estas variables la app funciona igual; solo queda deshabilitado el donar.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de la notificación webhook (Webhooks → Configurar notificaciones)
MERCADOPAGO_WEBHOOK_SECRET=

# Sentry (opcional) — sin esto, Sentry.init() no hace nada, no rompe nada.
# Creá un proyecto en sentry.io y completá para activar el reporte de errores.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
