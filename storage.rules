rules_version = '2';

// Firebase Storage Security Rules — Monteflori
// Cada usuario autenticado gestiona únicamente su propio avatar.
service firebase.storage {
  match /b/{bucket}/o {

    // ── Avatares de perfil ────────────────────────────────────────
    // Lectura: se permite cualquier nombre de archivo para no romper los
    // avatares que ya se habían subido con el esquema viejo (avatar.png, etc.).
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
    }

    // Escritura: SOLO la ruta fija avatars/{uid}/avatar.
    // Antes se aceptaba cualquier nombre de archivo, así que renombrando el
    // archivo local se podían acumular subidas de 5 MB sin tope. Con una ruta
    // única por usuario, cada subida reemplaza a la anterior.
    match /avatars/{uid}/avatar {
      allow write: if request.auth != null
        && request.auth.uid == uid
        // Solo imágenes
        && request.resource.contentType.matches('image/.*')
        // Máximo 5 MB
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Todo lo demás: denegado por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
