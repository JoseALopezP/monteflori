rules_version = '2';

// Firebase Storage Security Rules — Monteflori
// Permite a cada usuario autenticado leer y escribir únicamente su propio avatar.
service firebase.storage {
  match /b/{bucket}/o {

    // ── Avatares de perfil ────────────────────────────────────────
    // Ruta: avatars/{uid}/avatar.{ext}
    match /avatars/{uid}/{fileName} {
      // Cualquier usuario autenticado puede leer los avatares (para mostrarse en UI)
      allow read: if request.auth != null;

      // Solo el propio usuario puede escribir su avatar
      allow write: if request.auth != null
        && request.auth.uid == uid
        // Solo imágenes
        && request.resource.contentType.matches('image/.*')
        // Máximo 5 MB
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Todo lo demás: denegado por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
